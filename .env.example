# Copy to .env (git ignores it) and fill in from the Supabase dashboard.
#
# Anything starting with EXPO_PUBLIC_ is BUILT INTO THE APP, where anyone can read it.
# Only the two values below are safe there. Never give a secret that prefix.

# Project Settings -> API (safe to ship: Row Level Security protects the data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional, for `npm run db:push` and `npm run test:db` only. The app never reads it.
# Project Settings -> Database -> database password. SECRET: no EXPO_PUBLIC_ prefix.
# SUPABASE_DB_PASSWORD=
